rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Leitura pública para fotos e arquivos no site/plataforma
      allow read: if true;
      // Gravação permitida para usuários autenticados
      allow write: if request.auth != null;
    }
  }
}
